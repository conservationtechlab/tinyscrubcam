import json
import random
from datetime import date
from pathlib import Path
from shutil import copy2
from PIL import Image

species_configs = {
    "cougar": "/home/conor/Downloads/detections_cougar.json",
    "bobcat": "/home/conor/Downloads/detections_bobcat.json",
    "coyote": "/home/conor/Downloads/detections_coyote.json"
}

images_base_dir = Path("/home/conor/Downloads/Images/Species_Images")
output_base_dir = images_base_dir / "ei_dataset"
confidence_threshold = 0.2
train_split_ratio = 0.8

train_dir = output_base_dir / "training"
test_dir = output_base_dir / "testing"
train_dir.mkdir(parents=True, exist_ok=True)
test_dir.mkdir(parents=True, exist_ok=True)

zoom_percent = 0.1  # 10% zoom
box_margin = 30     # margin in pixels around bounding boxes (adjust between 20 and 50)

def zoom_image_with_boxes(image_path, boxes, output_path, margin=30):
    with Image.open(image_path) as im:
        width, height = im.size

        # Calculate zoom crop borders
        zoom_crop_x = int(width * zoom_percent / 2)
        zoom_crop_y = int(height * zoom_percent / 2)

        # Coordinates of the zoom crop box (crop border)
        crop_left = zoom_crop_x
        crop_top = zoom_crop_y
        crop_right = width - zoom_crop_x
        crop_bottom = height - zoom_crop_y

        # Check if all boxes will have at least 'margin' pixels space inside cropped image
        for box in boxes:
            box_left = box["x"]
            box_top = box["y"]
            box_right = box["x"] + box["width"]
            box_bottom = box["y"] + box["height"]

            # If any box is too close to crop edges minus margin, do NOT zoom/crop
            if (box_left < crop_left + margin or
                box_top < crop_top + margin or
                box_right > crop_right - margin or
                box_bottom > crop_bottom - margin):
                # Just copy original image and keep boxes as is
                copy2(image_path, output_path)
                return boxes

        # All boxes have margin, proceed with zoom and crop
        cropped = im.crop((crop_left, crop_top, crop_right, crop_bottom))
        zoomed = cropped.resize((width, height), Image.LANCZOS)

        # Now calculate final crop to keep margin space
        final_crop_left = margin
        final_crop_top = margin
        final_crop_right = width - margin
        final_crop_bottom = height - margin

        final = zoomed.crop((final_crop_left, final_crop_top, final_crop_right, final_crop_bottom))
        final.save(output_path)

        new_width, new_height = final.size

        # Adjust bounding boxes for zoom + crops
        new_boxes = []
        for box in boxes:
            # Shift for zoom crop
            box_x = box["x"] - crop_left
            box_y = box["y"] - crop_top

            # Scale due to zoom (resize back)
            scale_x = width / (width - 2 * zoom_crop_x)
            scale_y = height / (height - 2 * zoom_crop_y)
            box_x = int(box_x * scale_x)
            box_y = int(box_y * scale_y)
            box_w = int(box["width"] * scale_x)
            box_h = int(box["height"] * scale_y)

            # Shift for final margin crop
            box_x -= final_crop_left
            box_y -= final_crop_top

            # Ensure box still fits inside final image
            if (0 <= box_x < new_width and 0 <= box_y < new_height and
                box_x + box_w <= new_width and box_y + box_h <= new_height):
                new_boxes.append({
                    "label": box["label"],
                    "x": box_x,
                    "y": box_y,
                    "width": box_w,
                    "height": box_h,
                    "confidence": box.get("confidence", 0)
                })

        return new_boxes

def process_species(species, json_path):
    with open(json_path, 'r') as f:
        data = json.load(f)

    valid_images = []
    for img in data.get("images", []):
        file_name = Path(img["file"]).name
        full_image_path = images_base_dir / species / file_name
        if not full_image_path.exists():
            continue

        try:
            with Image.open(full_image_path) as im:
                width, height = im.size
        except:
            continue

        boxes = []
        for det in img.get("detections", []):
            if det.get("category") != "1" or det.get("conf", 0) < confidence_threshold:
                continue
            x, y, w, h = det["bbox"]
            boxes.append({
                "label": species,
                "x": int(x * width),
                "y": int(y * height),
                "width": int(w * width),
                "height": int(h * height),
                "confidence": round(det.get("conf", 0), 3)
            })

        if boxes:
            valid_images.append((file_name, species, boxes))

    random.shuffle(valid_images)
    split_idx = int(len(valid_images) * train_split_ratio)
    return valid_images[:split_idx], valid_images[split_idx:]

def build_edge_impulse_format(images, category, target_dir):
    version_str = f"{date.today()}-User"
    files_list = []

    for file_name, species, boxes in images:
        src = images_base_dir / species / file_name
        dst = target_dir / file_name
        new_boxes = zoom_image_with_boxes(src, boxes.copy(), dst, margin=box_margin)

        # If zoom_image_with_boxes returned None or empty list, fallback to original boxes
        if not new_boxes:
            new_boxes = boxes
            # Also ensure original image copied (if it wasn't)
            if not dst.exists():
                copy2(src, dst)

        files_list.append({
            "path": file_name,
            "category": category,
            "label": { "type": "label", "label": species },
            "metadata": { "version": version_str },
            "boundingBoxes": new_boxes
        })
    return files_list

train_files = []
test_files = []

for species, json_path in species_configs.items():
    train_imgs, test_imgs = process_species(species, json_path)
    train_files.extend(build_edge_impulse_format(train_imgs, "training", train_dir))
    test_files.extend(build_edge_impulse_format(test_imgs, "testing", test_dir))

with open(train_dir / "info.labels", "w") as f:
    json.dump({ "version": 1, "files": train_files }, f, indent=2)
with open(test_dir / "info.labels", "w") as f:
    json.dump({ "version": 1, "files": test_files }, f, indent=2)

print("✅ Dataset created with conditional zoom + margin + bounding box adjustment.")


